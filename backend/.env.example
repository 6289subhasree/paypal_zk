# Copy to backend/.env — never commit the real file.
JWT_SECRET=replace-with-a-long-random-string
FRONTEND_ORIGIN=http://localhost:3000

# Demo credential issuer key (32-byte hex). Generate: python -m app.cli new-issuer-key
ISSUER_PRIVATE_KEY_HEX=

# PayPal Sandbox (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret

# AI: ollama (local, free) | gemini (free tier) | none
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
GEMINI_API_KEY=

# Optional: PostgreSQL instead of the default SQLite file
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/zkpass
